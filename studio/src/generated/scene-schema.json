{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "A reviewable animation primitive.  Time references resolve against real TTS.",
      "properties": {
        "degrees": {
          "default": 0,
          "maximum": 360,
          "minimum": -360,
          "title": "Degrees",
          "type": "number"
        },
        "dx": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Dx",
          "type": "number"
        },
        "dy": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Dy",
          "type": "number"
        },
        "end": {
          "maxLength": 48,
          "minLength": 1,
          "title": "End",
          "type": "string"
        },
        "kind": {
          "enum": [
            "appear",
            "fade",
            "move",
            "scale",
            "rotate",
            "highlight",
            "draw",
            "morph"
          ],
          "title": "Kind",
          "type": "string"
        },
        "scale": {
          "default": 1,
          "maximum": 3,
          "minimum": 0.2,
          "title": "Scale",
          "type": "number"
        },
        "start": {
          "maxLength": 48,
          "minLength": 1,
          "title": "Start",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "kind",
        "start",
        "end"
      ],
      "title": "Action",
      "type": "object"
    },
    "Annotation": {
      "additionalProperties": false,
      "description": "A short callout on a chart at a real x position.\n\nAn annotation is data storytelling, not decoration: it must name a value that\nthe series actually contains (the renderer snaps to the nearest sample), so a\nmodel cannot invent a point on the curve that does not exist.",
      "properties": {
        "text": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "x": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "X",
          "type": "number"
        }
      },
      "required": [
        "x",
        "text"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "Beat": {
      "additionalProperties": false,
      "description": "A narrative beat. ``at`` is start/end/a 0–1 fraction/narration:substring.",
      "properties": {
        "at": {
          "maxLength": 48,
          "minLength": 1,
          "title": "At",
          "type": "string"
        },
        "purpose": {
          "maxLength": 60,
          "minLength": 2,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "at",
        "purpose"
      ],
      "title": "Beat",
      "type": "object"
    },
    "Cue": {
      "additionalProperties": false,
      "description": "A sound effect placed on the real narration timeline.\n\nOnly a bounded enumeration and a gain are accepted: the renderer synthesises\nthe sound locally, so nothing here can point at a remote or unlicensed file.",
      "properties": {
        "at": {
          "maxLength": 48,
          "minLength": 1,
          "title": "At",
          "type": "string"
        },
        "gain": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "kind": {
          "enum": [
            "whoosh",
            "tick",
            "impact",
            "riser",
            "chime"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "at",
        "kind"
      ],
      "title": "Cue",
      "type": "object"
    },
    "Cut": {
      "additionalProperties": false,
      "properties": {
        "cover_caption": {
          "default": "",
          "maxLength": 24,
          "title": "Cover Caption",
          "type": "string"
        },
        "description": {
          "maxLength": 1200,
          "minLength": 20,
          "title": "Description",
          "type": "string"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/Scene"
          },
          "maxItems": 14,
          "minItems": 3,
          "title": "Scenes",
          "type": "array"
        },
        "schema_version": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "style": {
          "default": "tech",
          "enum": [
            "minimal",
            "tech",
            "documentary"
          ],
          "title": "Style",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "maxLength": 50,
          "minLength": 2,
          "title": "Title",
          "type": "string"
        },
        "title_candidates": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Title Candidates",
          "type": "array"
        }
      },
      "required": [
        "title",
        "description",
        "tags",
        "scenes"
      ],
      "title": "Cut",
      "type": "object"
    },
    "DiagramEdge": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "",
          "maxLength": 12,
          "title": "Label",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 18,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "x": {
          "maximum": 1000,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 640,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "x",
        "y"
      ],
      "title": "DiagramNode",
      "type": "object"
    },
    "EventAnchor": {
      "additionalProperties": false,
      "description": "Where a semantic event sits: scene start/end, a fraction, or a phrase.\n\nRepeated phrases are disambiguated with ``occurrence`` (1-based) or an explicit\ncharacter range, so \"3\" in \"3 与 3 的平均\" never binds to the wrong one.",
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "fraction": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Fraction",
          "type": "number"
        },
        "kind": {
          "enum": [
            "start",
            "end",
            "fraction",
            "narration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "maximum": 9,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "text": {
          "default": "",
          "maxLength": 48,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EventAnchor",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "One bounded visual layer inside a scene.\n\nOnly enumerations, numbers and short strings are accepted.  File paths,\nURLs, code and unbounded lists are rejected by construction.",
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/Annotation"
          },
          "maxItems": 4,
          "title": "Annotations",
          "type": "array"
        },
        "axis": {
          "default": "",
          "maxLength": 16,
          "title": "Axis",
          "type": "string"
        },
        "chart": {
          "default": "line",
          "enum": [
            "line",
            "bar",
            "scatter"
          ],
          "title": "Chart",
          "type": "string"
        },
        "color": {
          "default": "cyan",
          "enum": [
            "cyan",
            "amber",
            "coral",
            "mint"
          ],
          "title": "Color",
          "type": "string"
        },
        "connect": {
          "default": false,
          "title": "Connect",
          "type": "boolean"
        },
        "data_ref": {
          "default": "",
          "maxLength": 32,
          "title": "Data Ref",
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "maxItems": 24,
          "title": "Edges",
          "type": "array"
        },
        "emphasis": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Emphasis",
          "type": "integer"
        },
        "highlight": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "title": "Highlight",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Id",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNode"
          },
          "maxItems": 12,
          "title": "Nodes",
          "type": "array"
        },
        "points": {
          "items": {
            "type": "number"
          },
          "maxItems": 64,
          "title": "Points",
          "type": "array"
        },
        "procedural": {
          "default": "",
          "maxLength": 16,
          "title": "Procedural",
          "type": "string"
        },
        "region": {
          "default": "main",
          "enum": [
            "main",
            "side",
            "top",
            "bottom",
            "annotation",
            "full"
          ],
          "title": "Region",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "maxItems": 4,
          "title": "Series",
          "type": "array"
        },
        "shape": {
          "default": "rect",
          "enum": [
            "point",
            "line",
            "rect",
            "circle",
            "arrow",
            "polygon",
            "bracket"
          ],
          "title": "Shape",
          "type": "string"
        },
        "source_note": {
          "default": "",
          "maxLength": 60,
          "title": "Source Note",
          "type": "string"
        },
        "state_after": {
          "default": "",
          "maxLength": 40,
          "title": "State After",
          "type": "string"
        },
        "state_before": {
          "default": "",
          "maxLength": 40,
          "title": "State Before",
          "type": "string"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Steps",
          "type": "array"
        },
        "subject_id": {
          "default": "",
          "maxLength": 24,
          "title": "Subject Id",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 120,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "shape",
            "math",
            "chart",
            "diagram",
            "timeline",
            "image",
            "procedural"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 8,
          "title": "Unit",
          "type": "string"
        },
        "visual_explanation": {
          "default": "",
          "maxLength": 120,
          "title": "Visual Explanation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Layer",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 12,
          "title": "Actions",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "maxItems": 6,
          "title": "Beats",
          "type": "array"
        },
        "camera": {
          "default": "push",
          "enum": [
            "none",
            "push",
            "pull",
            "pan_left",
            "pan_right"
          ],
          "title": "Camera",
          "type": "string"
        },
        "chapter": {
          "default": "",
          "maxLength": 8,
          "title": "Chapter",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Claim Ids",
          "type": "array"
        },
        "color": {
          "enum": [
            "cyan",
            "amber",
            "coral",
            "mint"
          ],
          "title": "Color",
          "type": "string"
        },
        "cues": {
          "items": {
            "$ref": "#/$defs/Cue"
          },
          "maxItems": 4,
          "title": "Cues",
          "type": "array"
        },
        "emphasis": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Emphasis",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/SemanticEvent"
          },
          "maxItems": 8,
          "title": "Events",
          "type": "array"
        },
        "function": {
          "default": "",
          "maxLength": 32,
          "title": "Function",
          "type": "string"
        },
        "heading": {
          "maxLength": 24,
          "minLength": 2,
          "title": "Heading",
          "type": "string"
        },
        "hero": {
          "default": "",
          "maxLength": 24,
          "title": "Hero",
          "type": "string"
        },
        "hold_reason": {
          "default": "",
          "maxLength": 60,
          "title": "Hold Reason",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "maxItems": 6,
          "title": "Layers",
          "type": "array"
        },
        "layout": {
          "default": "diagram",
          "enum": [
            "immersive",
            "diagram",
            "compare"
          ],
          "title": "Layout",
          "type": "string"
        },
        "matrix": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Matrix",
          "type": "array"
        },
        "metric": {
          "default": "",
          "maxLength": 16,
          "title": "Metric",
          "type": "string"
        },
        "narration": {
          "maxLength": 500,
          "minLength": 15,
          "title": "Narration",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Parameters",
          "type": "object"
        },
        "recipe": {
          "default": "",
          "maxLength": 32,
          "title": "Recipe",
          "type": "string"
        },
        "role": {
          "default": "mechanism",
          "enum": [
            "hook",
            "mechanism",
            "example",
            "turn",
            "conclusion"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_index": {
          "maximum": 5,
          "minimum": 0,
          "title": "Source Index",
          "type": "integer"
        },
        "takeaway": {
          "default": "",
          "maxLength": 30,
          "title": "Takeaway",
          "type": "string"
        },
        "transition": {
          "default": "fade",
          "enum": [
            "cut",
            "fade",
            "slide",
            "wipe",
            "dip",
            "zoom"
          ],
          "title": "Transition",
          "type": "string"
        },
        "transition_reason": {
          "default": "",
          "maxLength": 60,
          "title": "Transition Reason",
          "type": "string"
        },
        "visual": {
          "enum": [
            "matrix",
            "vectors",
            "projection",
            "wave",
            "network",
            "image_layers",
            "orbit"
          ],
          "title": "Visual",
          "type": "string"
        },
        "visual_intent": {
          "default": "",
          "maxLength": 240,
          "title": "Visual Intent",
          "type": "string"
        }
      },
      "required": [
        "id",
        "heading",
        "narration",
        "visual",
        "labels",
        "matrix",
        "color",
        "source_index"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SemanticEvent": {
      "additionalProperties": false,
      "description": "A named moment in a scene that other stages can bind to.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/EventAnchor"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,23}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "reveal",
            "transform",
            "compare",
            "conclude",
            "emphasis",
            "pause",
            "transition"
          ],
          "title": "Kind",
          "type": "string"
        },
        "offset_seconds": {
          "default": 0.0,
          "maximum": 5,
          "minimum": -5,
          "title": "Offset Seconds",
          "type": "number"
        },
        "purpose": {
          "default": "",
          "maxLength": 60,
          "title": "Purpose",
          "type": "string"
        },
        "target": {
          "default": "",
          "maxLength": 24,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "anchor"
      ],
      "title": "SemanticEvent",
      "type": "object"
    },
    "Series": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 8,
          "title": "Unit",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 60,
          "minItems": 2,
          "title": "Values",
          "type": "array"
        },
        "x_values": {
          "items": {
            "type": "number"
          },
          "maxItems": 60,
          "title": "X Values",
          "type": "array"
        }
      },
      "required": [
        "label",
        "values"
      ],
      "title": "Series",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "long": {
      "$ref": "#/$defs/Cut"
    },
    "short": {
      "$ref": "#/$defs/Cut"
    },
    "thesis": {
      "maxLength": 300,
      "minLength": 8,
      "title": "Thesis",
      "type": "string"
    },
    "title": {
      "maxLength": 80,
      "minLength": 2,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "thesis",
    "long",
    "short"
  ],
  "title": "Film",
  "type": "object"
}
